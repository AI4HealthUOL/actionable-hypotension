# Copy this file to ".env".
# Then set one DATABASE_URI below.

# --- Option A: PostgreSQL over TCP (most common) ---
# DATABASE_URI=postgresql+psycopg2://USERNAME:PASSWORD@HOST:PORT/DBNAME

# --- Option B: PostgreSQL via UNIX socket (/tmp, port 5432) ---
# DATABASE_URI=postgresql+psycopg2://USERNAME@/DBNAME?host=/tmp&port=5432

# --- Option C: SQLite (local dev only) ---
# DATABASE_URI=sqlite:///local.db

# Activate ONE of the lines above by removing the leading '#'
# and replacing placeholders. Leave this empty in the template.
DATABASE_URI=
